{
  "name": "sage-contracts",
  "version": "1.5.0",
  "description": "SAGE Registry Smart Contracts for Kaia Network",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean && npm run clean:generated",
    "clean:generated": "rm -rf typechain-types coverage coverage.json .nyc_output test-results gas-report.txt *.log logs dist build out tmp temp && find . -name '*.tmp' -o -name '*.temp' -o -name '*.bak' -o -name '*.backup' -o -name '*.old' | grep -v node_modules | xargs rm -f 2>/dev/null || true",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "node": "hardhat node",
    "console": "hardhat console"
  },
  "keywords": [
    "sage",
    "kaia",
    "klaytn",
    "blockchain",
    "smart-contracts",
    "did",
    "ai-agents"
  ],
  "author": "SAGE Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "axios": "^1.18.0",
    "chai": "^6.3.0",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.4",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.16"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "cookie": "^0.7.0",
    "lodash-es": "^4.18.0",
    "minimatch": {
      ".": "^10.2.1",
      "brace-expansion": "^5.0.7"
    },
    "glob": "^11.0.0",
    "diff": "^8.0.3",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.6",
    "ws": "^8.21.0",
    "adm-zip": "^0.6.0",
    "form-data": "^4.0.6",
    "mocha": "^11.8.0",
    "serialize-javascript": "^7.0.5",
    "esbuild": "^0.28.1"
  }
}
